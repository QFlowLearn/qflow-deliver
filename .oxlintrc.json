{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "apps/harbor-web/dist/**",
    "coverage/**",
    "dist/**",
    "node_modules/**",
    "playwright-report/**",
    "test-results/**",
    "workers/runtime/test-env.d.ts"
  ],
  "jsPlugins": [
    {
      "name": "landmines-testing",
      "specifier": "@interfere/landmines/testing"
    }
  ],
  "rules": {
    "landmines-testing/no-test-doubles": "error"
  }
}
