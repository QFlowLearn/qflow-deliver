<?xml version="1.0"?><qti-assessment-item xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0" identifier="item-1" title="Recovery responses" adaptive="false" time-dependent="false">
<qti-response-declaration identifier="CHOICE" cardinality="single" base-type="identifier"/>
<qti-response-declaration identifier="ESSAY" cardinality="single" base-type="string"/>
<qti-response-declaration identifier="ORDER" cardinality="ordered" base-type="identifier"/>
<qti-item-body><qti-choice-interaction response-identifier="CHOICE" max-choices="1"><qti-prompt>Choose a color.</qti-prompt><qti-simple-choice identifier="A">Amber</qti-simple-choice><qti-simple-choice identifier="B">Blue</qti-simple-choice></qti-choice-interaction>
<qti-extended-text-interaction response-identifier="ESSAY" expected-lines="5"><qti-prompt>Explain your reasoning.</qti-prompt></qti-extended-text-interaction>
<qti-order-interaction response-identifier="ORDER" shuffle="false"><qti-prompt>Put these steps in order.</qti-prompt><qti-simple-choice identifier="X">Inspect</qti-simple-choice><qti-simple-choice identifier="Y">Decide</qti-simple-choice><qti-simple-choice identifier="Z">Act</qti-simple-choice></qti-order-interaction></qti-item-body></qti-assessment-item>