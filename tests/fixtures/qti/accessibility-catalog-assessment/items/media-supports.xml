<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item
  xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0"
  identifier="media-supports"
  title="Media Supports"
  adaptive="false"
  time-dependent="false">
  <qti-response-declaration identifier="RESPONSE" cardinality="single" base-type="identifier"/>
  <qti-stylesheet href="styles/accessibility.css" type="text/css"/>
  <qti-item-body>
    <qti-prompt data-catalog-idref="audio-transcript">Review the presentation clip.</qti-prompt>
    <div data-catalog-idref="media-alternatives">
      <video width="320" height="180" controls="controls">
        <source src="media/presentation.mp4" type="video/mp4"/>
        <track kind="captions" src="captions/presentation-en.vtt" srclang="en" label="English"/>
      </video>
    </div>
    <p data-catalog-idref="missing-media-support">This paragraph references a catalog with no requested support.</p>
    <p data-catalog-idref="inline-glossary">Inline-only glossary term.</p>
    <p>The process called <span data-catalog-idref="photosynthesis-supports">photosynthesis</span> stores energy from light.</p>
  </qti-item-body>
  <qti-catalog-info>
    <qti-catalog id="audio-transcript">
      <qti-card support="transcript">
        <qti-card-entry xml:lang="en" default="true">
          <qti-file-href mime-type="text/html">transcripts/presentation-en.html</qti-file-href>
          <qti-html-content>
            <p>Inline English transcript summary.</p>
          </qti-html-content>
        </qti-card-entry>
        <qti-card-entry xml:lang="es">
          <qti-html-content>
            <p>Resumen de transcripcion en espanol.</p>
          </qti-html-content>
        </qti-card-entry>
      </qti-card>
    </qti-catalog>
    <qti-catalog id="media-alternatives">
      <qti-card support="caption">
        <qti-card-entry xml:lang="en" default="true">
          <qti-file-href mime-type="text/vtt">captions/presentation-en.vtt</qti-file-href>
        </qti-card-entry>
      </qti-card>
      <qti-card support="audio-description">
        <qti-card-entry default="true">
          <qti-file-href mime-type="video/mp4">media/described.mp4#t=2,9</qti-file-href>
        </qti-card-entry>
      </qti-card>
      <qti-card support="sign-language">
        <qti-card-entry xml:lang="ase" default="true">
          <qti-file-href mime-type="video/mp4">media/sign-language.mp4</qti-file-href>
          <qti-html-content>
            <p>ASL interpretation clip.</p>
          </qti-html-content>
        </qti-card-entry>
      </qti-card>
    </qti-catalog>
    <qti-catalog id="missing-media-support">
      <qti-card support="glossary-on-screen">
        <qti-card-entry default="true">
          <qti-file-href mime-type="text/html">glossary/missing.html</qti-file-href>
          <qti-html-content>
            <p>This support is not requested by the media control tests.</p>
          </qti-html-content>
        </qti-card-entry>
      </qti-card>
    </qti-catalog>
    <qti-catalog id="inline-glossary">
      <qti-card support="glossary-on-screen">
        <qti-card-entry default="true">
          <qti-html-content>
            <p>Inline glossary definition replaces a pending file request.</p>
          </qti-html-content>
        </qti-card-entry>
      </qti-card>
    </qti-catalog>
    <qti-catalog id="photosynthesis-supports">
      <qti-card support="keyword-translation">
        <qti-card-entry xml:lang="en" default="true">
          <qti-html-content><p>Photosynthesis</p></qti-html-content>
        </qti-card-entry>
        <qti-card-entry xml:lang="es">
          <qti-html-content><p>Fotosíntesis</p></qti-html-content>
        </qti-card-entry>
        <qti-card-entry xml:lang="fr-CA">
          <qti-file-href mime-type="text/plain">translations/photosynthesis-fr.txt</qti-file-href>
        </qti-card-entry>
        <qti-card-entry xml:lang="de">
          <qti-file-href mime-type="audio/mpeg">translations/photosynthesis-de.mp3</qti-file-href>
        </qti-card-entry>
        <qti-card-entry xml:lang="es-ES">
          <qti-file-href mime-type="video/mp4">translations/photosynthesis-es.mp4</qti-file-href>
        </qti-card-entry>
        <qti-card-entry xml:lang="ja">
          <qti-file-href mime-type="application/pdf">translations/photosynthesis-ja.pdf</qti-file-href>
        </qti-card-entry>
      </qti-card>
      <qti-card support="linguistic-guidance" xml:lang="en">
        <qti-html-content><p>Photo means light and synthesis means putting together.</p></qti-html-content>
      </qti-card>
    </qti-catalog>
  </qti-catalog-info>
</qti-assessment-item>
